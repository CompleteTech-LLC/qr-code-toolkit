{
  "name": "qr-code-toolkit",
  "version": "1.0.0",
  "description": "Self-hosted QR generator with YOURLS-backed dynamic QR support.",
  "main": "src/server/server.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke:qr": "tsx scripts/qr-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.14.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CompleteTech-LLC/qr-code-toolkit.git"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
