# Local development. npm run dev/start loads .env automatically.
HOST=127.0.0.1
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
DATA_FILE=.local/data/db.json
UPLOAD_DIR=.local/uploads

# Optional API authentication. Leave empty for local-only development.
# Protect remote deployments with an authenticated reverse proxy.
ADMIN_TOKEN=

# Optional YOURLS integration. Leave blank to use local redirects.
YOURLS_API_URL=
YOURLS_SIGNATURE=
YOURLS_SHORT_DOMAIN=

# Optional HTTPS termination in Node; otherwise terminate at your proxy.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
